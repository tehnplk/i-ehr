# Local Supabase database + realtime Docker settings.
# Copy to .env for local development and replace secrets before sharing beyond your machine.

POSTGRES_DB=<database>
POSTGRES_USER=<postgres_admin_user>
POSTGRES_PASSWORD=<postgres_admin_password>
POSTGRES_PORT=<postgres_host_port>

REALTIME_PORT=<realtime_host_port>
REALTIME_LOG_LEVEL=<log_level>
REALTIME_DB_ENC_KEY=<16_char_encryption_key>
REALTIME_SECRET_KEY_BASE=<64_char_secret>
REALTIME_METRICS_JWT_SECRET=<metrics_jwt_secret>
REALTIME_DASHBOARD_USER=<dashboard_user>
REALTIME_DASHBOARD_PASSWORD=<dashboard_password>

SUPABASE_JWT_SECRET=<jwt_secret>

# App-facing local URLs for this minimal database + realtime stack.
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
NEXT_PUBLIC_SUPABASE_REALTIME_URL=ws://<host>:<port>/socket
